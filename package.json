{
  "name": "raseed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "رصيد — نظام حسابات الموردين",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tools/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-raseed \"vitest run --project rules\"",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "admin:create-owner": "node tools/admin/create-owner.ts",
    "admin:reset-password": "node tools/admin/reset-password.ts",
    "test:e2e:auth": "firebase emulators:exec --only auth,firestore --project demo-raseed \"playwright test -c playwright.auth.config.ts\"",
    "migrate": "node tools/migrate/migrate.ts",
    "backup": "node tools/backup/backup.ts",
    "backup:restore": "node tools/backup/restore.ts"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "firebase": "^13.0.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "officecrypto-tool": "0.0.19",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
