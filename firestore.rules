rules_version = '2';

// قواعد «رصيد»: الصلاحيات تُفرض هنا من الخادم (خطة Spark بلا Cloud Functions).
// المرجع: SPEC.md §1 «الأدوار» و§3-ب، وDECISIONS.md. الافتراضي: الرفض.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- الهوية والأدوار ----------
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function isEnabled() { return signedIn() && exists(userPath(request.auth.uid)) && me().active == true; }
    // من عليه تغيير كلمة المرور المؤقتة لا يصل لشيء قبل تغييرها (عدا مستنده وإزالة العلم)
    function isActive() { return isEnabled() && me().get('mustChangePassword', false) != true; }
    function role() { return me().role; }
    function isOwner() { return isActive() && role() == 'owner'; }
    function isManager() { return isActive() && role() in ['owner', 'admin']; }
    function canSeeSupplier(sid) {
      return isManager() || (isActive() && role() == 'entry' && sid in me().assigned);
    }

    // ---------- قفل الفترات (تاريخ إقفال واحد) ----------
    function lockPath() { return /databases/$(database)/documents/settings/lock; }
    function lockedThrough() { return exists(lockPath()) ? get(lockPath()).data.lockedThrough : '0000-00-00'; }
    function isOpenDate(d) { return d is string && d > lockedThrough(); }
    function isIsoDate(d) { return d is string && d.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }

    // ---------- سجل التدقيق: كل كتابة تُرفق بسجل جديد في الدفعة نفسها ----------
    function auditPath(aid) { return /databases/$(database)/documents/auditLog/$(aid); }
    function audited(entity, id) {
      let aid = request.resource.data.auditId;
      let a = getAfter(auditPath(aid)).data;
      return aid is string
        && !exists(auditPath(aid))
        && a.entity == entity && a.entityId == id && a.actor == request.auth.uid;
    }
    // سبب إلزامي مكتوب في سجل التدقيق المرفق (قفل الفترات، الحذف والاسترجاع)
    function auditReasonOk() {
      let a = getAfter(auditPath(request.resource.data.auditId)).data;
      return a.reason is string && a.reason.size() > 0 && a.reason.size() <= 300;
    }

    // ---------- المال والمرجع ----------
    function money(x) { return x is int && x >= 0 && x <= 9999999999; }
    function computedRefNo(d) {
      return d.kind == 'inv' ? 'P' + d.mainRef : 'MISC/' + d.date[0:4] + '/' + d.date[5:7] + '/' + d.mainRef;
    }
    function refKey(refNo) { return refNo.replace('/', '|'); }
    function refPath(key) { return /databases/$(database)/documents/refs/$(key); }
    // الفاتورة 5 أرقام والقيد 4؛ المراجع ببادئة (OUT/…) بلا فرض طول (DECISIONS 2026-10-10)
    function refFormatOk(d) {
      return d.mainRef is string && d.mainRef.size() > 0 && d.mainRef.size() <= 40
        && d.mainRef.matches('^[A-Z0-9ء-ي/-]+$')
        && (!d.mainRef.matches('^[0-9]+$') || d.mainRef.size() == (d.kind == 'inv' ? 5 : 4));
    }
    // الفاتورة دائن والقيد مدين، والعكس فقط بعلم صريح reversed (مرتجع/استرداد)
    function directionOk(d) {
      let credit = (d.kind == 'inv') != d.reversed;
      return d.reversed is bool
        && (credit ? (d.credit > 0 && d.debit == 0) : (d.debit > 0 && d.credit == 0));
    }
    // فهرس الرقم المرجعي يُكتب مع الحركة؛ التكرار مسموح بتأكيد وسبب (تحذير صارم غير حاجب).
    // الفهرس الفارغ (حرّره تعديل أو حذف) لا يُعدّ تكراراً.
    function refIndexed(d, eid) {
      let key = refKey(d.refNo);
      return eid in getAfter(refPath(key)).data.ids
        && (!exists(refPath(key)) || get(refPath(key)).data.ids.removeAll([eid]).size() == 0
            || (d.dup is map && d.dup.reason is string && d.dup.reason.size() > 0 && d.dup.reason.size() <= 300));
    }

    // ---------- حالة Odoo (للفواتير فقط) ----------
    function odooInitial(d) {
      return d.kind == 'inv'
        ? (d.odoo is map && d.odoo.entered == false && d.odoo.keys().hasOnly(['entered', 'by', 'at', 'reason', 'reasonText', 'lockReason']))
        : !('odoo' in d);
    }
    function odooChangeOk(before, after) {
      return (!('odoo' in after) && !('odoo' in before))
        || ('odoo' in after && 'odoo' in before && after.odoo == before.odoo)
        || (after.kind == 'inv' && after.odoo.keys().hasOnly(['entered', 'by', 'at', 'reason', 'reasonText', 'lockReason'])
            && after.odoo.by == request.auth.uid && after.odoo.at == request.time
            && (after.odoo.entered == true
                || (after.odoo.reason in ['wrong', 'cancelled', 'other']
                    && after.odoo.reasonText is string && after.odoo.reasonText.size() <= 300
                    && (after.odoo.reason != 'other' || after.odoo.reasonText.size() > 0))));
    }

    // ---------- شكل الحركة ----------
    function entryKeys() {
      return ['supplierId', 'kind', 'date', 'mainRef', 'refNo', 'voucher', 'details', 'debit', 'credit', 'reversed',
              'note', 'odoo', 'dup', 'needsManualFix', 'deleted', 'deletion', 'auditId', 'createdBy', 'createdAt', 'updatedAt'];
    }
    function commonShapeOk(d) {
      return d.keys().hasOnly(entryKeys())
        && d.supplierId is string && isIsoDate(d.date)
        && money(d.debit) && money(d.credit) && !(d.debit > 0 && d.credit > 0)
        && d.deleted is bool && d.needsManualFix is bool;
    }
    function financialOk(d) {
      return d.voucher is string && d.voucher.matches('^[0-9]{0,12}$')
        && d.details is string && d.details.size() <= 200
        && directionOk(d) && refFormatOk(d) && d.refNo == computedRefNo(d);
    }
    function noteOk(d) {
      return d.debit == 0 && d.credit == 0 && d.note is string && d.note.size() > 0 && d.note.size() <= 1000;
    }

    // ---------- المستخدمون ----------
    match /users/{uid} {
      function validUser(d) {
        return d.keys().hasOnly(['displayName', 'login', 'role', 'assigned', 'active', 'mustChangePassword', 'auditId', 'createdAt', 'updatedAt'])
          && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 80
          && d.login is string && d.login.size() <= 120
          && d.role in ['owner', 'admin', 'entry'] && d.assigned is list && d.active is bool
          && (!('mustChangePassword' in d) || d.mustChangePassword is bool);
      }
      // أول دخول بكلمة مؤقتة (DECISIONS 2026-10-10): صاحب الحساب يزيل العلم فقط، ولا يغيّر غيره
      function clearsOwnPasswordFlag() {
        return uid == request.auth.uid && isEnabled()
          && resource.data.get('mustChangePassword', false) == true
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt', 'auditId'])
          && audited('users', uid);
      }
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      // المالك يُنشأ بسكربت الإعداد فقط؛ الإدارة تدير الجميع عدا المالك
      // الحساب الجديد يبدأ بكلمة مؤقتة دائماً، فيُلزَم بتغييرها
      allow create: if isManager() && validUser(request.resource.data)
        && request.resource.data.role in ['admin', 'entry']
        && request.resource.data.mustChangePassword == true
        && audited('users', uid);
      allow update: if isManager() && validUser(request.resource.data) && audited('users', uid)
        && ((resource.data.role != 'owner' && request.resource.data.role != 'owner')
            || (isOwner() && uid == request.auth.uid
                && request.resource.data.role == 'owner' && request.resource.data.active == true))
        || clearsOwnPasswordFlag();
      allow delete: if false;
    }

    // ---------- الإعدادات ----------
    // قفل الفترات (DECISIONS 2026-10-11، الخيار ب): المالك وحده، بسبب إلزامي في التدقيق، ولا تاريخ بعد اليوم.
    // الفتح المؤقت يحفظ التاريخ السابق في tempFrom (بعد تاريخ القفل الجديد) ليُعاد إليه لاحقاً.
    match /settings/lock {
      function notFuture(d) {
        return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) <= request.time;
      }
      allow read: if isActive();
      allow write: if isOwner() && isIsoDate(request.resource.data.lockedThrough)
        && notFuture(request.resource.data.lockedThrough)
        && request.resource.data.keys().hasOnly(['lockedThrough', 'tempFrom', 'auditId'])
        && (!('tempFrom' in request.resource.data)
            || (isIsoDate(request.resource.data.tempFrom)
                && request.resource.data.tempFrom > request.resource.data.lockedThrough))
        && audited('settings', 'lock') && auditReasonOk();
    }
    // حالة النسخ الاحتياطي اليومي: يكتبها سير GitHub Actions بمفتاح الخادم وحده، ويقرؤها المالك والإدارة
    // في مركز الإشعارات (DECISIONS 2026-10-11).
    match /settings/backup {
      allow read: if isManager();
      allow write: if false;
    }
    // مدة الخمول قبل إنهاء الجلسة (دقائق): يضبطها المالك (DECISIONS 2026-10-10)
    match /settings/session {
      allow read: if isActive();
      allow write: if isOwner() && request.resource.data.keys().hasOnly(['idleMinutes', 'auditId'])
        && request.resource.data.idleMinutes is int
        && request.resource.data.idleMinutes >= 5 && request.resource.data.idleMinutes <= 120
        && audited('settings', 'session');
    }
    match /settings/roleNames {
      allow read: if isActive();
      allow write: if isOwner() && request.resource.data.keys().hasOnly(['owner', 'admin', 'entry', 'auditId'])
        && request.resource.data.owner is string && request.resource.data.owner.size() <= 40
        && request.resource.data.admin is string && request.resource.data.admin.size() <= 40
        && request.resource.data.entry is string && request.resource.data.entry.size() <= 40
        && audited('settings', 'roleNames');
    }

    // ---------- الموردون ----------
    match /suppliers/{sid} {
      allow read: if canSeeSupplier(sid);
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['name', 'status', 'auditId', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.status in ['active', 'archived']
        && audited('suppliers', sid);
      allow delete: if false;
    }

    // ---------- الحركات ----------
    match /entries/{eid} {
      function entryUpdateShapeOk(before, after, id) {
        return after.kind == 'note' ? noteOk(after)
          // حركة منقولة بلا نوع تبقى كما هي حتى تُصنَّف
          : after.kind == 'untyped' ? before.kind == 'untyped'
          : after.kind in ['inv', 'misc'] && directionOk(after)
            && after.voucher is string && after.voucher.matches('^[0-9]{0,12}$')
            && after.details is string && after.details.size() <= 200
            // المراجع المنقولة المخالفة للطول تبقى قابلة للتعديل ما دام المرجع لم يتغير
            && (refFormatOk(after) || (after.mainRef == before.mainRef && after.kind == before.kind))
            && (after.refNo == computedRefNo(after) || after.refNo == before.refNo)
            && (after.refNo == before.refNo || refIndexed(after, id));
      }

      allow read: if isManager() || (canSeeSupplier(resource.data.supplierId) && resource.data.deleted == false);

      // الإضافة: كل الأدوار، ومدخل البيانات لموردينه فقط
      allow create: if isActive() && canSeeSupplier(request.resource.data.supplierId)
        && commonShapeOk(request.resource.data)
        && request.resource.data.kind in ['inv', 'misc', 'note']
        && (request.resource.data.kind == 'note' ? noteOk(request.resource.data)
            : (financialOk(request.resource.data) && refIndexed(request.resource.data, eid)))
        && odooInitial(request.resource.data)
        && isOpenDate(request.resource.data.date)
        && request.resource.data.deleted == false && request.resource.data.needsManualFix == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && audited('entries', eid);

      // التعديل: المالك والإدارة فقط، خارج الفترة المقفلة، مع سجل تدقيق. المحذوفة لا تُعدَّل،
      // والحذف والاسترجاع بقاعدتهما أدناه.
      allow update: if isManager()
        && resource.data.deleted == false && request.resource.data.deleted == false
        && !('deletion' in request.resource.data)
        && isOpenDate(resource.data.date) && isOpenDate(request.resource.data.date)
        && commonShapeOk(request.resource.data)
        && request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && entryUpdateShapeOk(resource.data, request.resource.data, eid)
        && odooChangeOk(resource.data, request.resource.data)
        && audited('entries', eid);

      // الحذف الناعم والاسترجاع (SPEC §1، DECISIONS 2026-10-11 الخيار أ): المالك وحده، خارج الفترة المقفلة،
      // بسبب إلزامي في التدقيق. الحذف يحفظ من حذف ومتى ولماذا ولا يغيّر غير ذلك، ويُحرَّر رقمه المرجعي
      // (قاعدة refs). الاسترجاع يعيده إلى فهرس رقمه، وبتأكيد وسبب إن كان الرقم قد استُعمل بعده.
      function deletionOk(x) {
        return x is map && x.keys().hasOnly(['by', 'at', 'reason'])
          && x.by == request.auth.uid && x.at == request.time
          && x.reason is string && x.reason.size() > 0 && x.reason.size() <= 300;
      }
      function hasRef(d) { return d.kind in ['inv', 'misc'] && d.get('refNo', '') != ''; }
      allow update: if isOwner()
        && isOpenDate(resource.data.date)
        && request.resource.data.updatedAt == request.time
        && audited('entries', eid) && auditReasonOk()
        && ((resource.data.deleted == false && request.resource.data.deleted == true
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletion', 'updatedAt', 'auditId'])
             && deletionOk(request.resource.data.deletion))
          || (resource.data.deleted == true && request.resource.data.deleted == false
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletion', 'dup', 'updatedAt', 'auditId'])
             && !('deletion' in request.resource.data)
             && (!hasRef(request.resource.data) || refIndexed(request.resource.data, eid))));

      // استثناء الفترة المقفلة (DECISIONS 2026-10-10): المالك وحده يغيّر حالة Odoo لفاتورة مقفلة،
      // بسبب مكتوب إلزامي، ولا يتغير أي حقل آخر.
      allow update: if isOwner()
        && resource.data.deleted == false
        && !isOpenDate(resource.data.date)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['odoo', 'updatedAt', 'auditId'])
        && request.resource.data.updatedAt == request.time
        && resource.data.kind == 'inv'
        && odooChangeOk(resource.data, request.resource.data)
        && request.resource.data.odoo.lockReason is string
        && request.resource.data.odoo.lockReason.size() > 0 && request.resource.data.odoo.lockReason.size() <= 300
        && audited('entries', eid);

      allow delete: if false;
    }

    // ---------- فهرس الأرقام المرجعية ----------
    match /refs/{key} {
      // places: مكان كل حركة بالرقم نفسه (المورد واسمه)، ليظهر في التحذير الصارم
      // لكل مستخدم ولو كان المورد غير مسند إليه (DECISIONS 2026-10-10)
      function entryAfter(id) { return getAfter(/databases/$(database)/documents/entries/$(id)).data; }
      function placeOk(p, id) {
        return p.keys().hasOnly(['entryId', 'supplierId', 'supplierName'])
          && p.entryId == id
          && p.supplierId == entryAfter(id).supplierId
          && p.supplierName == get(/databases/$(database)/documents/suppliers/$(p.supplierId)).data.name;
      }
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['ids', 'places'])
        && request.resource.data.ids.size() == 1 && request.resource.data.places.size() == 1
        && refKey(entryAfter(request.resource.data.ids[0]).refNo) == key
        && placeOk(request.resource.data.places[0], request.resource.data.ids[0]);
      allow update: if isActive()
        && request.resource.data.keys().hasOnly(['ids', 'places'])
        && request.resource.data.ids.size() == resource.data.ids.size() + 1
        && request.resource.data.places.size() == resource.data.places.size() + 1
        && request.resource.data.ids.hasAll(resource.data.ids)
        && request.resource.data.places.hasAll(resource.data.places)
        && refKey(entryAfter(request.resource.data.ids[request.resource.data.ids.size() - 1]).refNo) == key
        && placeOk(request.resource.data.places[request.resource.data.places.size() - 1],
                   request.resource.data.ids[request.resource.data.ids.size() - 1]);
      // تعديل الحركة (DECISIONS 2026-10-11): إن انتقلت إلى رقم آخر في الدفعة نفسها، أو حُذفت، تُزال
      // من فهرس رقمها وحدها (المالك والإدارة فقط؛ الحذف نفسه للمالك بقاعدته)، فلا يبقى تكرار وهمي.
      allow update: if isManager()
        && request.resource.data.keys().hasOnly(['ids', 'places'])
        && request.resource.data.ids.size() == resource.data.ids.size() - 1
        && request.resource.data.places.size() == resource.data.places.size() - 1
        && resource.data.ids.hasAll(request.resource.data.ids)
        && resource.data.places.hasAll(request.resource.data.places)
        && resource.data.ids.removeAll(request.resource.data.ids).size() == 1
        && resource.data.places.removeAll(request.resource.data.places)[0].entryId
             == resource.data.ids.removeAll(request.resource.data.ids)[0]
        && (refKey(entryAfter(resource.data.ids.removeAll(request.resource.data.ids)[0]).refNo) != key
            || entryAfter(resource.data.ids.removeAll(request.resource.data.ids)[0]).deleted == true);
      allow delete: if false;
    }

    // ---------- أسباب «التعديل اليدوي» للبيانات المنقولة (المرحلة 3) ----------
    // ينشئها سكربت النقل وحده (firebase-admin)؛ تُقرأ في مركز المراجعة للمالك والإدارة.
    // المالك والإدارة يغيّرون حقول الحل فقط، بسجل تدقيق في الدفعة نفسها (DECISIONS 2026-10-11).
    match /migrationIssues/{eid} {
      function resolutionOk(d) {
        return d.resolved is bool
          && d.resolvedBy == request.auth.uid && d.resolvedAt == request.time
          && (d.resolved ? d.resolution in ['ignored', 'fixed', 'deleted'] : d.resolution == 'reopened')
          // «حُذفت» تُغلق مع حذف حركتها في الدفعة نفسها فقط (DECISIONS 2026-10-11)
          && (d.resolution != 'deleted'
              || getAfter(/databases/$(database)/documents/entries/$(eid)).data.deleted == true)
          && d.resolutionNote is string && d.resolutionNote.size() <= 300;
      }
      allow read: if isManager();
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['resolved', 'resolution', 'resolutionNote', 'resolvedBy', 'resolvedAt', 'auditId'])
        && resolutionOk(request.resource.data)
        && audited('migrationIssues', eid);
      allow create, delete: if false;
    }

    // ---------- سجل التدقيق: إضافة فقط، لا تعديل ولا حذف ----------
    match /auditLog/{aid} {
      allow read: if isManager();
      allow create: if (isActive()
          || (isEnabled() && request.resource.data.entity == 'users' && request.resource.data.entityId == request.auth.uid
              && request.resource.data.action == 'passwordChanged'))
        && request.resource.data.keys().hasOnly(['actor', 'at', 'action', 'entity', 'entityId', 'before', 'after', 'reason'])
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.entity in ['entries', 'users', 'suppliers', 'settings', 'migrationIssues']
        && request.resource.data.entityId is string
        && request.resource.data.action is string && request.resource.data.action.size() <= 40;
      allow update, delete: if false;
    }
  }
}
